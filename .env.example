# --- Database (docker compose) ---
POSTGRES_USER=stock
POSTGRES_DB=stock
POSTGRES_PASSWORD=change-me
# Inside Docker the host must be "db", not localhost.
DATABASE_URL=postgresql://stock:change-me@db:5432/stock?schema=public

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Resend ---
RESEND_API_KEY=re_xxx

# --- Assistant / model ---
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
ASSISTANT_MODEL=deepseek-v4-flash

# --- Caddy ---
# Leave empty on the raw Elastic IP. Set the subdomain once DNS exists.
APP_DOMAIN=
